# ─── Swadesh Vaani Server Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values on the deployment machine.
# NEVER share or commit the actual .env file.

# Admin Gmail address (used to send subscriber & forgot-password emails)
ADMIN_EMAIL=swadeshvaaniofficial@gmail.com

# Gmail App Password (NOT your normal password)
# How to generate: https://myaccount.google.com/apppasswords
# 1. Enable 2-Step Verification on the Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Paste the 16-character code below (spaces are fine)
ADMIN_EMAIL_PASS=your_16_char_app_password_here

# Server port (optional, default: 5001)
PORT=5001
