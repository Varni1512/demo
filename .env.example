# ==========================================
# Swadesh Vaani - Environment Configuration
# ==========================================

# --- Firebase Configuration (Firestore & Auth) ---
# Paste your web app config from Firebase Console:
# Project Settings -> General -> Your apps -> Web app (</>)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Cloudinary Configuration (Image Uploads) ---
# Get these from Cloudinary Console (https://cloudinary.com/console)
# Set up an "Unsigned" Upload Preset in: Settings -> Upload -> Upload presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

